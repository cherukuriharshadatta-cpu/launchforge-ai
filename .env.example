# Cloudinary — required
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# Optional beta / gated Cloudinary analysis features. Leave false unless enabled on your account.
CLOUDINARY_ACCESSIBILITY_ANALYSIS=false
CLOUDINARY_C2PA_ENABLED=false

# Optional real LaunchForge user login via Supabase.
# If omitted, V7 exposes an honest local demo login instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Instagram professional account publishing (Business/Creator)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Example: http://localhost:3000/api/social/instagram/callback
INSTAGRAM_REDIRECT_URI=
# Keep configurable because Meta versions change.
META_GRAPH_VERSION=v25.0

# YouTube OAuth + upload
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Example: http://localhost:3000/api/social/youtube/callback
GOOGLE_REDIRECT_URI=
